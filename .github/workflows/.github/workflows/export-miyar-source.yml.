
name: Export Miyar 1.0.4 Hotfix Source

'on':
  push:
    branches:
      - main
    paths:
      - '.github/workflows/export-miyar-source.yml'

permissions:
  contents: read

jobs:
  export-source:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract and validate Miyar source
        shell: bash
        run: |
          set -euo pipefail

          ARCHIVE="Miyar-Update-1.0.4-Hotfix.zip"

          test -s "$ARCHIVE"

          rm -rf miyar-source
          mkdir -p miyar-source

          unzip -q "$ARCHIVE" -d miyar-source

          test -f miyar-source/settings.gradle.kts
          test -f miyar-source/build.gradle.kts
          test -f miyar-source/app/build.gradle.kts
          test -f miyar-source/app/src/main/AndroidManifest.xml

          grep -Fq 'applicationId = "com.miyar.app"' \
            miyar-source/app/build.gradle.kts

          grep -Fq 'versionCode = 26' \
            miyar-source/app/build.gradle.kts

          grep -Fq 'versionName = "1.0.4"' \
            miyar-source/app/build.gradle.kts

          echo "Miyar 1.0.4 Hotfix source validated."

      - name: Package extracted source
        shell: bash
        run: |
          set -euo pipefail
          cd miyar-source
          zip -qr ../Miyar-1.0.4-Hotfix-Source.zip .

      - name: Upload extracted source
        uses: actions/upload-artifact@v4
        with:
          name: Miyar-1.0.4-Hotfix-Source
          path: Miyar-1.0.4-Hotfix-Source.zip
          if-no-files-found: error
          retention-days: 7
